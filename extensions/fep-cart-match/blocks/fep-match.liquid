<div
  data-fep-block
  data-fep-default-route="{{ block.settings.default_route | default: 'where_needed_most' }}"
  data-fep-intent-version="fep-intent-v1"
></div>

{{ 'fep-match.css' | asset_url | stylesheet_tag }}
<script src="{{ 'fep-match.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Bravvi FEP preference",
  "target": "section",
  "settings": [
    {
      "type": "select",
      "id": "default_route",
      "label": "Default impact preference",
      "default": "where_needed_most",
      "options": [
        { "value": "where_needed_most", "label": "Where it is needed most" },
        { "value": "work_enablement", "label": "Work enablement" },
        { "value": "community_support", "label": "Community support" },
        { "value": "environment_restoration", "label": "Environment restoration" }
      ]
    }
  ]
}
{% endschema %}
