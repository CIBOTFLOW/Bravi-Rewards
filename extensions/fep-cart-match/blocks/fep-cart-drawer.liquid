<div
  data-fep-embed
  hidden
  data-fep-context="drawer"
  data-fep-enabled="{{ block.settings.enabled }}"
  data-fep-cent-variant-id="{{ block.settings.contribution_cent_variant_id | default: '8720793665590' }}"
  data-fep-dollar-variant-id="{{ block.settings.contribution_dollar_variant_id | default: '8721388634166' }}"
  data-fep-default-route="{{ block.settings.default_route | default: 'where_needed_most' }}"
  data-fep-primary-percent="{{ block.settings.primary_percent | default: 2.5 }}"
  data-fep-secondary-percent="{{ block.settings.secondary_percent | default: 5 }}"
  data-fep-intent-version="fep-contribution-v2"
></div>

{{ 'fep-match.css' | asset_url | stylesheet_tag }}
<script src="{{ 'fep-match.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "FEP Movement cart drawer",
  "target": "body",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable Movement contribution",
      "default": false,
      "info": "G0 kill switch. Leave off until B03 passes G1 and explicit G2 GO authorizes activation."
    },
    {
      "type": "text",
      "id": "contribution_cent_variant_id",
      "label": "$0.01 contribution variant ID",
      "default": "8720793665590"
    },
    {
      "type": "text",
      "id": "contribution_dollar_variant_id",
      "label": "$1.00 contribution variant ID",
      "default": "8721388634166"
    },
    {
      "type": "range",
      "id": "primary_percent",
      "label": "First contribution percentage",
      "min": 1,
      "max": 10,
      "step": 0.5,
      "unit": "%",
      "default": 2.5
    },
    {
      "type": "range",
      "id": "secondary_percent",
      "label": "Second contribution percentage",
      "min": 1,
      "max": 10,
      "step": 0.5,
      "unit": "%",
      "default": 5
    },
    {
      "type": "select",
      "id": "default_route",
      "label": "Default Movement route",
      "default": "where_needed_most",
      "options": [
        { "value": "where_needed_most", "label": "Where it is needed most" },
        { "value": "work_enablement", "label": "Work enablement" },
        { "value": "community_support", "label": "Community support" },
        { "value": "environment_restoration", "label": "Environment restoration" }
      ]
    }
  ]
}
{% endschema %}
