{
  "name": "bravi-web",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "verify:http": "node scripts/verify-dev.mjs",
    "verify:production": "node scripts/verify-dev.mjs --production",
    "check": "npm run typecheck && npm test && npm run build && npm run verify:http && npm run verify:production"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
